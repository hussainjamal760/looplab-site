# ========================================
# Looplab Backend — Environment Variables
# ========================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/looplab?retryWrites=true&w=majority

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Authentication
JWT_SECRET=change_me_this_must_be_at_least_32_characters_long_secret
JWT_EXPIRES_IN=7d

# Cloudinary (receipt image storage)
CLOUDINARY_CLOUD_NAME=looplab-media
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Seed Admin (used only by npm run seed:admin)
SEED_ADMIN_NAME=LoopLab Admin
SEED_ADMIN_EMAIL=admin@looplab.org
SEED_ADMIN_PASSWORD=change_me_strong_password_here
